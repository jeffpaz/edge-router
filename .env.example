# .env.example — copy to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   nano .env
#   ./deploy.sh
#
# Do NOT commit .env to version control — it contains secrets.
# This file (.env.example) is safe to commit.

# ── Ollama (local model) ──────────────────────────────────────────────────────
# Default connects via host.docker.internal (the host's Docker bridge gateway).
# This works out of the box on any Docker-on-Linux setup including Jetson.
#
# Alternative — once deploy.sh has run and connected the ollama container to
# the shared edge-net network, you can switch to the container hostname:
#   OLLAMA_BASE_URL=http://ollama:11434
#
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# ── Routing ───────────────────────────────────────────────────────────────────
# Minimum confidence score [0.0–1.0] to use the local model's answer.
# Below this, the query is classified and sent to the matching cloud LLM.
CONFIDENCE_THRESHOLD=0.70

# ── Cloud API keys ────────────────────────────────────────────────────────────
# Note on naming: the .env uses friendly provider names (GEMINI, GROK).
# docker-compose.yml maps these to the SDK variable names the app reads
# (GOOGLE_API_KEY, XAI_API_KEY) — you don't need to set those separately.
#
# Only keys for providers you actually use are required:
#   coding queries      → Claude  (ANTHROPIC_API_KEY)
#   math / data queries → Gemini  (GEMINI_API_KEY)
#   current events      → Grok    (GROK_API_KEY)
#   general fallback    → OpenAI  (OPENAI_API_KEY)

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=

# ── Cloud model overrides (optional) ─────────────────────────────────────────
# Uncomment to pin a specific model version. Defaults are set in config.py.
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-1.5-pro
# GROK_MODEL=grok-2-latest
# OPENAI_MODEL=gpt-4o

# ── Tiered routing: PRIVATE lane on the Mac mini (tiers.py) ──────────────────
# Unset either one → the PRIVATE lane is disabled and anything that needs it
# (POST /jobs/*) fails closed. Cloud-down fallback then goes straight to the Jetson.
MINI_OLLAMA_URL=http://192.168.11.60:11434
MINI_MODEL=qwen3:4b-instruct
# Must match the mini daemon's OLLAMA_CONTEXT_LENGTH and TRIPBUDDY_OLLAMA_NUM_CTX
MINI_NUM_CTX=8192
# MINI_TIMEOUT_S=120
# Whole cloud fallback chain gets this long before falling back to mini → Jetson
# CLOUD_LANE_TIMEOUT_S=60
# Live-data questions: Grok via the Responses API with web_search / x_search
# GROK_SEARCH_MODEL=grok-4.7

# tripBuddy shares the mini's Ollama; same model keeps one runner loaded
TRIPBUDDY_OLLAMA_MODEL=qwen3:4b-instruct

# ── Private-lane access (auth.private_identity) ──────────────────────────────
# Firebase ID token for a verified email in this list, or PRIVATE_TOKEN for
# scripts. Both empty → nobody can use the private lane.
PRIVATE_ALLOWED_EMAILS=
PRIVATE_TOKEN=

# ── Firebase auth on /query and /ask (auth.py) ───────────────────────────────
# AUTH_ENABLED=true verifies and logs tokens; AUTH_REQUIRED=true also rejects.
AUTH_ENABLED=false
AUTH_REQUIRED=false
